<Window x:Class="MCLauncher.Views.TextInputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Ввод"
        
        Height="230" Width="480"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource BgDeep}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
        <Grid Margin="22">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock x:Name="TxtTitle" Text="Ввод" Style="{StaticResource H1}" FontSize="18"/>
                <TextBlock x:Name="TxtPrompt" Text="" Foreground="{DynamicResource FgMuted}"
                           FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <TextBox x:Name="TxtValue" Grid.Row="1" VerticalAlignment="Center" Height="38"
                     KeyDown="TxtValue_KeyDown"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource BaseButton}" Content="Отмена" MinWidth="96"
                        Click="BtnCancel_Click"/>
                <Button Style="{StaticResource AccentButton}" Content="Продолжить" MinWidth="130"
                        Margin="10,0,0,0" Click="BtnOk_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
