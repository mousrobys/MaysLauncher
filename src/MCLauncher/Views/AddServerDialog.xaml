<Window x:Class="MCLauncher.Views.AddServerDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Добавить сервер"
        
        Height="340" Width="460"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI">

    <Border Background="{DynamicResource CyberBg}" CornerRadius="14"
            BorderBrush="{DynamicResource NeonBorder}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#FF2D95"/>
        </Border.Effect>
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <TextBlock Text="Добавить сервер" Style="{StaticResource H1}"/>
                <TextBlock Text="Он появится в списке с проверкой онлайна"
                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel Grid.Row="1" Margin="0,20,0,0">
                <TextBlock Text="НАЗВАНИЕ" Style="{StaticResource Caption}"/>
                <TextBox x:Name="TxtName"/>

                <TextBlock Text="АДРЕС" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                <TextBox x:Name="TxtAddress" ToolTip="например: play.example.com или 1.2.3.4:25565"/>

                <TextBlock Text="ВЕРСИЯ (для кнопки «Играть»)" Style="{StaticResource Caption}" Margin="0,14,0,6"/>
                <TextBox x:Name="TxtVersion" Text="26.2"/>

                <TextBlock x:Name="TxtStatus" Text="" Foreground="{DynamicResource Danger}"
                           FontSize="11.5" Margin="0,12,0,0" TextWrapping="Wrap"/>
            </StackPanel>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Style="{StaticResource BaseButton}" Content="Отмена" MinWidth="96"
                        Click="BtnCancel_Click"/>
                <Button Style="{StaticResource AccentButton}" Content="Добавить" MinWidth="120"
                        Margin="10,0,0,0" Click="BtnAdd_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
