<Window x:Class="MCLauncher.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="MaysLauncher"
        Icon="pack://application:,,,/icon=logo.ico.ico"
        Height="700" Width="1140"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <Border Background="{DynamicResource BgDeep}" CornerRadius="14"
            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
        <Border.Clip>
            <RectangleGeometry Rect="0,0,1140,700" RadiusX="14" RadiusY="14"/>
        </Border.Clip>
        <Grid>
            <!-- Фоновая картинка пользователя -->
            <Rectangle x:Name="WindowBgLayer" Fill="Transparent" IsHitTestVisible="False"/>

            <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- ================= ЗАГОЛОВОК ================= -->
            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="18,0,0,0">
                    <Border Width="22" Height="22" CornerRadius="6" ClipToBounds="True">
                        <Image Source="pack://application:,,,/icon=logo.ico.ico" Stretch="UniformToFill"
                               RenderOptions.BitmapScalingMode="HighQuality"/>
                    </Border>
                    <TextBlock Text="MaysLauncher" FontWeight="Bold" FontSize="13.5"
                               VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Style="{StaticResource Chip}" Margin="12,0,0,0" Background="#1B1F26">
                        <TextBlock Text="Minecraft: Java Edition" Style="{StaticResource ChipText}"/>
                    </Border>

                    <!-- Индикатор запущенной игры -->
                    <Border x:Name="RunningBadge" Style="{StaticResource Chip}" Margin="8,0,0,0"
                            Background="#14301F" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Style="{StaticResource StatusDot}" Fill="{DynamicResource Accent}"/>
                            <TextBlock x:Name="TxtRunningBadge" Text="Игра запущена"
                                       Style="{StaticResource ChipText}" Margin="7,0,0,0"
                                       Foreground="{DynamicResource Accent}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnMinimize" Style="{StaticResource TitleBarButton}"
                            Content="&#xE921;" Click="BtnMinimize_Click" ToolTip="Свернуть"/>
                    <Button x:Name="BtnClose" Style="{StaticResource CloseButton}"
                            Content="&#xE8BB;" Click="BtnClose_Click" ToolTip="Закрыть"/>
                </StackPanel>
            </Grid>

            <!-- ================= ТЕЛО ================= -->
            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="212"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- НАВИГАЦИЯ -->
                <Border Grid.Column="0" Background="{DynamicResource Bg}" CornerRadius="0,0,0,13">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,10,0,0">
                            <RadioButton x:Name="NavHome" Style="{StaticResource NavToggle}"
                                         IsChecked="True" Checked="Nav_Checked" Tag="0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Главная" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavInstances" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="1">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8FD;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Версии" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavMods" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Моды" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavContent" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="7">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE8B7;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Контент" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavServers" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="2">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE968;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Серверы" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavBot" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE99A;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Бот" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavAccount" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="3">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE77B;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Аккаунт" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavSettings" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="4">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Настройки" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>

                            <RadioButton x:Name="NavConsole" Style="{StaticResource NavToggle}"
                                         Checked="Nav_Checked" Tag="5">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="&#xE756;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                               VerticalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock Text="Консоль" Margin="12,0,0,0" VerticalAlignment="Center"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"/>
                                </StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <!-- Профиль -->
                        <Border Grid.Row="2" Margin="12,0,12,14" Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1"
                                CornerRadius="10" Padding="10">
                            <StackPanel Orientation="Horizontal">
                                <Border Width="36" Height="36" CornerRadius="8" Background="#262B34" ClipToBounds="True">
                                    <Image x:Name="ImgAvatar" Stretch="UniformToFill"
                                           RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                </Border>
                                <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock x:Name="TxtSideName" Text="Не выполнен вход"
                                               FontWeight="SemiBold" FontSize="12"
                                               TextTrimming="CharacterEllipsis" MaxWidth="112"/>
                                    <TextBlock x:Name="TxtSideStatus" Text="Оффлайн"
                                               Foreground="{DynamicResource FgMuted}" FontSize="10.5"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!-- КОНТЕНТ -->
                <Grid Grid.Column="1">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- ============ 0. ГЛАВНАЯ ============ -->
                    <Grid x:Name="PageHome" Grid.Row="0" Margin="24,14,24,0">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Играть" Style="{StaticResource H1}"/>
                            <TextBlock Text="Официальный клиент Minecraft с серверов Mojang"
                                       Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <!-- Баннер -->
                        <Border x:Name="HomeBanner" Grid.Row="1" Margin="0,16,0,0" CornerRadius="14" Height="188">
                            <Grid>
                                <Image x:Name="ImgCustomBanner" Stretch="UniformToFill" Opacity="0.55"
                                       Visibility="Collapsed"/>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" VerticalAlignment="Center" Margin="26,0,0,0">
                                        <TextBlock x:Name="TxtBannerVersion" Text="Выберите сборку"
                                                   FontSize="29" FontWeight="Bold"/>
                                        <TextBlock x:Name="TxtBannerInfo" Text="Загружаю список версий..."
                                                   Foreground="{DynamicResource FgMuted}" FontSize="12.5" Margin="0,6,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                            <Border Style="{StaticResource Chip}" Background="#1E2A22" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtBadgeJava" Text="Java: поиск…"
                                                           Style="{StaticResource ChipText}"
                                                           Foreground="{DynamicResource Accent}"/>
                                            </Border>
                                            <Border Style="{StaticResource Chip}" Margin="0,0,8,0">
                                                <TextBlock x:Name="TxtBadgeRam" Text="RAM: 4096 МБ"
                                                           Style="{StaticResource ChipText}"/>
                                            </Border>
                                            <Border x:Name="ChipLoader" Style="{StaticResource Chip}">
                                                <TextBlock x:Name="TxtBadgeLoader" Text="Vanilla"
                                                           Style="{StaticResource ChipText}"/>
                                            </Border>
                                        </StackPanel>
                                    </StackPanel>

                                    <Border Grid.Column="1" Width="146" Margin="0,0,22,0" ClipToBounds="True">
                                        <Image x:Name="ImgBannerSkin" Stretch="Uniform" Margin="0,14"
                                               RenderOptions.BitmapScalingMode="NearestNeighbor"
                                               VerticalAlignment="Center"/>
                                    </Border>
                                </Grid>
                            </Grid>
                        </Border>

                        <!-- Новости -->
                        <Border Grid.Row="2" Margin="0,14,0,0" CornerRadius="12" Background="{DynamicResource Panel}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <TextBlock Text="📰 Новости" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8"/>
                                <StackPanel x:Name="NewsPanel" Grid.Row="1"/>
                            </Grid>
                        </Border>

                        <!-- Быстрые действия -->
                        <Grid Grid.Row="3" Margin="0,14,0,0" VerticalAlignment="Top">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="0" Style="{StaticResource IconButton}" Margin="0,0,5,0"
                                    Height="62" Click="QuickMods_Click" ToolTip="Открыть папку с модами">
                                <StackPanel>
                                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="TxtQuickMods" Text="Моды" FontSize="11.5" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="1" Style="{StaticResource IconButton}" Margin="5,0"
                                    Height="62" Click="QuickResourcePacks_Click" ToolTip="Открыть папку ресурспаков">
                                <StackPanel>
                                    <TextBlock Text="&#xE8B9;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="TxtQuickRp" Text="Ресурспаки" FontSize="11.5" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="2" Style="{StaticResource IconButton}" Margin="5,0"
                                    Height="62" Click="QuickShaders_Click" ToolTip="Открыть папку шейдеров">
                                <StackPanel>
                                    <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="TxtQuickShaders" Text="Шейдеры" FontSize="11.5" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Grid.Column="3" Style="{StaticResource IconButton}" Margin="5,0,0,0"
                                    Height="62" Click="QuickScreenshots_Click" ToolTip="Открыть скриншоты">
                                <StackPanel>
                                    <TextBlock Text="&#xE722;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                               HorizontalAlignment="Center" Foreground="{DynamicResource Accent}"/>
                                    <TextBlock x:Name="TxtQuickShots" Text="Скриншоты" FontSize="11.5" Margin="0,5,0,0"
                                               HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Grid>

                    <!-- ============ 1. ВЕРСИИ / СБОРКИ ============ -->
                    <Grid x:Name="PageInstances" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Версии и сборки" Style="{StaticResource H1}"/>
                                <TextBlock Text="ЛКМ — выбрать и настроить справа  ·  ПКМ — быстрое меню"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Button x:Name="BtnNewInstance" Style="{StaticResource AccentButton}"
                                    Content="+  Создать сборку" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Click="BtnNewInstance_Click"/>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="300"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Список сборок -->
                            <Border Grid.Column="0" Background="{DynamicResource Panel}" CornerRadius="12"
                                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" Padding="8">
                              <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <TextBox x:Name="TxtInstanceSearch" Grid.Row="0" Height="32" Margin="2,2,2,8"
                                         Visibility="Collapsed" TextChanged="TxtInstanceSearch_Changed"
                                         ToolTip="Поиск по названию, версии или загрузчику"/>

                                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                                              PreviewMouseWheel="ListScroll_PreviewMouseWheel">
                                    <ListBox x:Name="LstInstances" Style="{StaticResource PlainListBox}"
                                             SelectionChanged="LstInstances_SelectionChanged"
                                             PreviewMouseRightButtonDown="LstInstances_RightClick">
                                        <ListBox.ContextMenu>
                                            <ContextMenu Background="{DynamicResource Panel}"
                                                         BorderBrush="{DynamicResource BorderBrushDark}">
                                                <MenuItem Header="Играть" Click="CtxPlay_Click"
                                                          FontWeight="Bold"/>
                                                <Separator/>
                                                <MenuItem Header="Переименовать…" Click="CtxRename_Click"/>
                                                <MenuItem Header="Настройки сборки" Click="CtxSettings_Click"/>
                                                <MenuItem Header="Изменить память…" Click="CtxMemory_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Папка модов" Click="OpenMods_Click"/>
                                                <MenuItem Header="Папка сборки" Click="OpenInstanceRoot_Click"/>
                                                <MenuItem Header="Скриншоты" Click="OpenScreenshots_Click"/>
                                                <Separator/>
                                                <MenuItem Header="Дублировать" Click="BtnDuplicateInstance_Click"/>
                                                <MenuItem Header="Удалить" Click="BtnDeleteInstance_Click"
                                                          Foreground="{DynamicResource Danger}"/>
                                            </ContextMenu>
                                        </ListBox.ContextMenu>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Style="{StaticResource HoverCard}" CornerRadius="9"
                                                        Padding="11" BorderThickness="1"
                                                        Background="{DynamicResource Panel}">
                                                    <Border.ToolTip>
                                                        <ToolTip Background="{DynamicResource Panel}"
                                                                 BorderBrush="{DynamicResource Accent}"
                                                                 BorderThickness="1" Padding="10">
                                                            <StackPanel MaxWidth="280">
                                                                <TextBlock Text="{Binding Name}" FontWeight="Bold"
                                                                           FontSize="13"
                                                                           Foreground="{DynamicResource Fg}"/>
                                                                <TextBlock Margin="0,6,0,0" FontSize="11.5"
                                                                           Foreground="{DynamicResource FgMuted}"
                                                                           TextWrapping="Wrap">
                                                                    <Run Text="Minecraft "/>
                                                                    <Run Text="{Binding McVersion, Mode=OneWay}"/>
                                                                    <LineBreak/>
                                                                    <Run Text="Загрузчик: "/>
                                                                    <Run Text="{Binding LoaderDisplay, Mode=OneWay}"/>
                                                                    <LineBreak/>
                                                                    <Run Text="Наиграно: "/>
                                                                    <Run Text="{Binding PlayTimeDisplay, Mode=OneWay}"/>
                                                                </TextBlock>
                                                                <TextBlock Text="ЛКМ — открыть, ПКМ — меню действий"
                                                                           FontSize="10.5" Margin="0,8,0,0"
                                                                           Foreground="{DynamicResource Accent}"/>
                                                            </StackPanel>
                                                        </ToolTip>
                                                    </Border.ToolTip>
                                                    <StackPanel>
                                                        <StackPanel Orientation="Horizontal">
                                                            <Border Width="18" Height="18" CornerRadius="4"
                                                                    VerticalAlignment="Center" ClipToBounds="True">
                                                                <Grid>
                                                                    <Border CornerRadius="4"
                                                                            Background="{Binding IconBrush}"/>
                                                                    <Image Source="{Binding IconImage}"
                                                                           Stretch="UniformToFill"/>
                                                                </Grid>
                                                            </Border>
                                                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                                                       FontSize="13" Margin="9,0,0,0"
                                                                       Foreground="{DynamicResource Fg}"
                                                                       TextTrimming="CharacterEllipsis" MaxWidth="190"/>
                                                        </StackPanel>
                                                        <TextBlock Margin="19,4,0,0" FontSize="11"
                                                                   Foreground="{DynamicResource FgMuted}">
                                                            <Run Text="{Binding McVersion, Mode=OneWay}"/>
                                                            <Run Text=" · "/>
                                                            <Run Text="{Binding LoaderDisplay, Mode=OneWay}"/>
                                                        </TextBlock>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </ScrollViewer>
                              </Grid>
                            </Border>

                            <!-- Детали сборки -->
                            <ScrollViewer Grid.Column="1" Margin="14,0,0,0" VerticalScrollBarVisibility="Auto">
                                <StackPanel x:Name="PanelInstanceDetails" Margin="0,0,6,10">

                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <StackPanel>
                                                    <TextBlock x:Name="TxtInstName" Text="Сборка не выбрана"
                                                               Style="{StaticResource H2}" FontSize="17"/>
                                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                            <TextBlock x:Name="TxtInstVersion" Text="—"
                                                                       Style="{StaticResource ChipText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Margin="0,0,6,0">
                                                            <TextBlock x:Name="TxtInstLoader" Text="—"
                                                                       Style="{StaticResource ChipText}"/>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}">
                                                            <TextBlock x:Name="TxtInstPlaytime" Text="—"
                                                                       Style="{StaticResource ChipText}"/>
                                                        </Border>
                                                    </StackPanel>
                                                </StackPanel>
                                                <Button x:Name="BtnDeleteInstance" Style="{StaticResource DangerButton}"
                                                        Content="Удалить" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Click="BtnDeleteInstance_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Папки -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ПАПКИ СБОРКИ" Style="{StaticResource Caption}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <Grid.RowDefinitions>
                                                    <RowDefinition Height="Auto"/>
                                                    <RowDefinition Height="Auto"/>
                                                </Grid.RowDefinitions>

                                                <Button Grid.Row="0" Grid.Column="0" Margin="0,0,4,8"
                                                        Style="{StaticResource IconButton}" Click="OpenMods_Click">
                                                    <StackPanel>
                                                        <TextBlock x:Name="TxtFolderMods" Text="Моды"
                                                                   FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="TxtCountMods" Text="0 файлов"
                                                                   FontSize="10.5" Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Row="0" Grid.Column="1" Margin="4,0,4,8"
                                                        Style="{StaticResource IconButton}" Click="OpenResourcePacks_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="Ресурспаки" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="TxtCountRp" Text="0 файлов"
                                                                   FontSize="10.5" Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Row="0" Grid.Column="2" Margin="4,0,0,8"
                                                        Style="{StaticResource IconButton}" Click="OpenShaders_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="Шейдеры" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="TxtCountShaders" Text="0 файлов"
                                                                   FontSize="10.5" Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Row="1" Grid.Column="0" Margin="0,0,4,0"
                                                        Style="{StaticResource IconButton}" Click="OpenSaves_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="Миры" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="TxtCountWorlds" Text="0 миров"
                                                                   FontSize="10.5" Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Row="1" Grid.Column="1" Margin="4,0"
                                                        Style="{StaticResource IconButton}" Click="OpenInstanceRoot_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="Корень сборки" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock x:Name="TxtInstSize" Text="—"
                                                                   FontSize="10.5" Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>

                                                <Button Grid.Row="1" Grid.Column="2" Margin="4,0,0,0"
                                                        Style="{StaticResource IconButton}" Click="OpenLogs_Click">
                                                    <StackPanel>
                                                        <TextBlock Text="Логи и краши" FontWeight="SemiBold" FontSize="12"/>
                                                        <TextBlock Text="диагностика" FontSize="10.5"
                                                                   Foreground="#8B93A3" Margin="0,2,0,0"/>
                                                    </StackPanel>
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!-- Профили модов и обслуживание -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ПРОФИЛИ МОДОВ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Наборы модов внутри одной сборки — удобно переключать между съёмками."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="0,0,0,10" TextWrapping="Wrap"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <ComboBox x:Name="CbModProfile" Grid.Column="0" Height="34"
                                                          SelectionChanged="CbModProfile_Changed"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Новый" Margin="8,0,0,0"
                                                        Click="BtnNewModProfile_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource DangerButton}"
                                                        Content="Удалить" Margin="8,0,0,0" Padding="10,7"
                                                        Click="BtnDeleteModProfile_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtProfileInfo" Text="" FontSize="10.5"
                                                       Foreground="{DynamicResource FgMuted}" Margin="0,8,0,0"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ОБСЛУЖИВАНИЕ СБОРКИ" Style="{StaticResource Caption}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}"
                                                        Content="Проверить целостность" Margin="0,0,8,0"
                                                        Click="BtnCheckIntegrity_Click"/>
                                                <Button Style="{StaticResource IconButton}"
                                                        Content="Обновить моды" Margin="0,0,8,0"
                                                        Click="BtnCheckModUpdates_Click"/>
                                                <Button Style="{StaticResource IconButton}"
                                                        Content="Найти конфликты"
                                                        Click="BtnFindConflicts_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtInstHealth" Text="" FontSize="11.5"
                                                       Foreground="{DynamicResource FgMuted}" Margin="0,10,0,0"
                                                       TextWrapping="Wrap" LineHeight="18"/>
                                        </StackPanel>
                                    </Border>

                                    <!-- Статистика -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="СТАТИСТИКА" Style="{StaticResource Caption}"/>
                                            <Grid Margin="0,0,0,12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <StackPanel Grid.Column="0">
                                                    <TextBlock x:Name="TxtStatTotal" Text="—" FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Accent}"/>
                                                    <TextBlock Text="всего в игре" FontSize="10.5"
                                                               Foreground="{DynamicResource FgMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock x:Name="TxtStatSessions" Text="—" FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Fg}"/>
                                                    <TextBlock Text="запусков" FontSize="10.5"
                                                               Foreground="{DynamicResource FgMuted}"/>
                                                </StackPanel>
                                                <StackPanel Grid.Column="2">
                                                    <TextBlock x:Name="TxtStatAvg" Text="—" FontSize="17"
                                                               FontWeight="Bold"
                                                               Foreground="{DynamicResource Fg}"/>
                                                    <TextBlock Text="средняя сессия" FontSize="10.5"
                                                               Foreground="{DynamicResource FgMuted}"/>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Text="Последние 14 дней" FontSize="10.5"
                                                       Foreground="{DynamicResource FgMuted}" Margin="0,0,0,6"/>
                                            <ItemsControl x:Name="ItemsChart" Height="86">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <StackPanel Orientation="Horizontal"
                                                                    VerticalAlignment="Bottom"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <StackPanel Width="26" VerticalAlignment="Bottom"
                                                                    ToolTip="{Binding Tip}">
                                                            <Border Height="{Binding BarHeight}" Width="16"
                                                                    CornerRadius="3,3,0,0"
                                                                    Background="{Binding Bar}"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Bottom"/>
                                                            <TextBlock Text="{Binding Label}" FontSize="9"
                                                                       HorizontalAlignment="Center" Margin="0,4,0,0"
                                                                       Foreground="{DynamicResource FgMuted}"/>
                                                        </StackPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <!-- Настройки сборки -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="НАСТРОЙКИ ЭТОЙ СБОРКИ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Пустое поле или 0 — использовать общую настройку лаунчера."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="0,0,0,12" TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Название" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstEditName" Grid.Column="1"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Память, МБ" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstMemory" Grid.Column="1"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"
                                                         ToolTip="0 = как в общих настройках"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Размер окна" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstWidth" Grid.Column="1"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"/>
                                                <TextBlock Text="×" Grid.Column="2" VerticalAlignment="Center"
                                                           Margin="8,0" Foreground="{DynamicResource FgMuted}"/>
                                                <TextBox x:Name="TxtInstHeight" Grid.Column="3"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Автосервер" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstServer" Grid.Column="1"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"
                                                         ToolTip="Подключаться к серверу сразу при запуске"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Своя Java" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstJava" Grid.Column="1" IsReadOnly="True"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="Обзор" Margin="8,0,0,0"
                                                        Click="BtnInstJava_Click"/>
                                            </Grid>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Пресет JVM" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <ComboBox x:Name="CbJvmPreset" Grid.Column="1" Height="34"
                                                          SelectionChanged="CbJvmPreset_Changed"/>
                                            </Grid>

                                            <TextBlock x:Name="TxtJvmPresetInfo" Text="" FontSize="10.5"
                                                       Foreground="{DynamicResource FgMuted}" Margin="130,0,0,10"
                                                       TextWrapping="Wrap"/>

                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Иконка сборки" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <Border Grid.Column="1" Height="34" CornerRadius="7"
                                                        Background="{DynamicResource Bg}" HorizontalAlignment="Left"
                                                        Width="34" ClipToBounds="True">
                                                    <Grid>
                                                        <Image x:Name="ImgInstIcon" Stretch="UniformToFill"/>
                                                        <Border x:Name="InstIconDot" Width="12" Height="12"
                                                                CornerRadius="3"/>
                                                    </Grid>
                                                </Border>
                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                    <Button Style="{StaticResource IconButton}" Content="Выбрать"
                                                            Margin="8,0,0,0" Click="BtnInstIcon_Click"/>
                                                    <Button Style="{StaticResource IconButton}" Content="Убрать"
                                                            Margin="8,0,0,0" Click="BtnInstIconClear_Click"/>
                                                </StackPanel>
                                            </Grid>

                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="130"/>
                                                    <ColumnDefinition Width="*"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="Свои аргументы" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtInstJvm" Grid.Column="1"
                                                         LostFocus="InstSetting_Changed" TextChanged="InstSettingText_Changed"/>
                                            </Grid>

                                            <Border Style="{StaticResource Divider}"/>

                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="Язык: русский"
                                                        Margin="0,0,8,0" Click="BtnInstSetRu_Click"
                                                        ToolTip="Записать русский язык в options.txt"/>
                                                <Button Style="{StaticResource IconButton}" Content="Дублировать сборку"
                                                        Margin="0,0,8,0" Click="BtnDuplicateInstance_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="Сбросить настройки"
                                                        Click="BtnResetInstance_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!-- Скриншоты -->
                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="СКРИНШОТЫ" Style="{StaticResource Caption}"/>
                                                <Button x:Name="BtnOpenShots" Style="{StaticResource IconButton}"
                                                        Content="Открыть папку" HorizontalAlignment="Right"
                                                        VerticalAlignment="Top" Margin="0,-6,0,0"
                                                        Click="OpenScreenshots_Click"/>
                                            </Grid>

                                            <TextBlock x:Name="TxtNoShots" Text="Скриншотов пока нет. В игре нажмите F2."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,4,0,0"/>

                                            <ItemsControl x:Name="ItemsScreenshots" Margin="0,6,0,0">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate>
                                                        <WrapPanel Orientation="Horizontal"/>
                                                    </ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="132" Height="78" CornerRadius="8" Margin="0,0,8,8"
                                                                Background="#161A21" ClipToBounds="True" Cursor="Hand"
                                                                MouseLeftButtonUp="Screenshot_Click" Tag="{Binding Path}"
                                                                ToolTip="{Binding Name}">
                                                            <Image Source="{Binding Thumb}" Stretch="UniformToFill"/>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>
                    </Grid>

                    <!-- ============ 2. СЕРВЕРЫ ============ -->
                    <Grid x:Name="PageServers" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Серверы" Style="{StaticResource H1}"/>
                                <TextBlock Text="Онлайн обновляется в реальном времени"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button x:Name="BtnAddServer" Style="{StaticResource IconButton}"
                                        Content="+ Добавить" Margin="0,0,8,0" Click="BtnAddServer_Click"/>
                                <Button x:Name="BtnRefreshServers" Style="{StaticResource IconButton}"
                                        Content="Обновить" Click="BtnRefreshServers_Click"/>
                            </StackPanel>
                        </Grid>

                        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ItemsServers" Margin="0,0,6,10">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="{DynamicResource Panel}" CornerRadius="12" Padding="16"
                                                Margin="0,0,0,12" BorderThickness="1"
                                                BorderBrush="{DynamicResource BorderBrushDark}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>

                                                <!-- Иконка -->
                                                <Border Grid.Column="0" Width="60" Height="60" CornerRadius="10"
                                                        Background="#161A21" ClipToBounds="True">
                                                    <Grid>
                                                        <Image Source="{Binding Favicon}" Stretch="UniformToFill"
                                                               RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                        <TextBlock Text="{Binding Initial}" FontSize="24" FontWeight="Bold"
                                                                   Foreground="#3A4150" HorizontalAlignment="Center"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding PlaceholderVisibility}"/>
                                                    </Grid>
                                                </Border>

                                                <!-- Инфо -->
                                                <StackPanel Grid.Column="1" Margin="14,0,12,0" VerticalAlignment="Center">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="15"/>
                                                        <Border Style="{StaticResource Chip}" Margin="10,0,0,0"
                                                                Background="{Binding StatusBg}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Ellipse Width="7" Height="7" VerticalAlignment="Center"
                                                                         Fill="{Binding StatusColor}"/>
                                                                <TextBlock Text="{Binding StatusText}" FontSize="10.5"
                                                                           Margin="6,0,0,0" VerticalAlignment="Center"
                                                                           Foreground="{Binding StatusColor}"/>
                                                            </StackPanel>
                                                        </Border>
                                                        <Border Style="{StaticResource Chip}" Margin="6,0,0,0"
                                                                Visibility="{Binding FeaturedVisibility}"
                                                                Background="#2A2418">
                                                            <TextBlock Text="Партнёр" FontSize="10.5"
                                                                       Foreground="#FACC15" VerticalAlignment="Center"/>
                                                        </Border>
                                                    </StackPanel>

                                                    <TextBlock Text="{Binding Motd}" Foreground="{DynamicResource FgMuted}"
                                                               FontSize="11.5" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"
                                                               MaxHeight="34" TextWrapping="Wrap"/>

                                                    <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                        <TextBlock Text="{Binding Address}" FontSize="11"
                                                                   Foreground="#6B7280" FontFamily="Consolas"/>
                                                        <TextBlock Text="{Binding VersionInfo}" FontSize="11"
                                                                   Foreground="#6B7280" Margin="12,0,0,0"/>
                                                        <TextBlock Text="{Binding PingInfo}" FontSize="11"
                                                                   Foreground="#6B7280" Margin="12,0,0,0"/>
                                                    </StackPanel>
                                                </StackPanel>

                                                <!-- Действия -->
                                                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                    <TextBlock Text="{Binding Players}" FontSize="18" FontWeight="Bold"
                                                               HorizontalAlignment="Center"
                                                               Foreground="{Binding StatusColor}"/>
                                                    <TextBlock Text="игроков" FontSize="10" HorizontalAlignment="Center"
                                                               Foreground="#6B7280" Margin="0,0,0,8"/>
                                                    <Button Content="ИГРАТЬ" Style="{StaticResource AccentButton}"
                                                            MinWidth="118" Click="ServerPlay_Click"
                                                            Tag="{Binding Address}"/>
                                                    <Button Content="Копировать IP" Style="{StaticResource IconButton}"
                                                            Margin="0,6,0,0" Click="ServerCopy_Click"
                                                            Tag="{Binding Address}"/>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ 3. АККАУНТ ============ -->
                    <Grid x:Name="PageAccount" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0">
                            <TextBlock Text="Аккаунт" Style="{StaticResource H1}"/>
                            <TextBlock Text="Microsoft или локальный оффлайн-профиль"
                                       Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="1" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,6,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="248"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                    <StackPanel>
                                        <Border Height="222" CornerRadius="10" Background="#161A21">
                                            <Grid>
                                                <Image x:Name="ImgSkinPreview" Stretch="Uniform" Margin="12"
                                                       RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                                                <TextBlock x:Name="TxtSkinPlaceholder"
                                                           Text="Войдите, чтобы&#x0a;увидеть скин"
                                                           TextAlignment="Center" Foreground="{DynamicResource FgMuted}"
                                                           FontSize="12" HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"/>
                                            </Grid>
                                        </Border>
                                        <TextBlock x:Name="TxtAccName" Text="—" FontWeight="Bold" FontSize="15"
                                                   Margin="0,12,0,0" HorizontalAlignment="Center"/>
                                        <TextBlock x:Name="TxtAccUuid" Text="" Foreground="{DynamicResource FgMuted}"
                                                   FontSize="10" HorizontalAlignment="Center" Margin="0,3,0,0"
                                                   TextWrapping="Wrap" TextAlignment="Center"/>
                                        <Button x:Name="BtnRefreshSkin" Style="{StaticResource BaseButton}"
                                                Content="Обновить превью" Margin="0,12,0,0" Click="BtnRefreshSkin_Click"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ТЕКУЩИЙ АККАУНТ" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="TxtAuthState" Text="Вы не вошли в аккаунт."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="12"
                                                       TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button x:Name="BtnLogin" Style="{StaticResource AccentButton}"
                                                        Content="Войти через Microsoft" MinWidth="196"
                                                        IsEnabled="False"
                                                        ToolTip="Функция временно недоступна"/>
                                                <Button x:Name="BtnLogout" Style="{StaticResource DangerButton}"
                                                        Content="Выйти" Margin="10,0,0,0" Click="BtnLogout_Click"
                                                        IsEnabled="False" MinWidth="110"/>
                                            </StackPanel>
                                            <Border Background="#2A1A1D" CornerRadius="8" Padding="11,8"
                                                    Margin="0,12,0,0">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets"
                                                               FontSize="13" VerticalAlignment="Center"
                                                               Foreground="{DynamicResource Danger}"/>
                                                    <TextBlock Text="Вход через Microsoft временно не обслуживается — сервис на техническом обслуживании. Используйте оффлайн-профиль ниже."
                                                               Foreground="{DynamicResource Danger}" FontSize="11.5"
                                                               Margin="9,0,0,0" TextWrapping="Wrap" MaxWidth="430"/>
                                                </StackPanel>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ОФФЛАЙН-АККАУНТ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Локальный профиль для одиночной игры и серверов с online-mode=false."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                            <Grid Margin="0,12,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtOfflineName" Grid.Column="0" MaxLength="16"
                                                         TextChanged="TxtOfflineName_TextChanged"
                                                         KeyDown="TxtOfflineName_KeyDown"/>
                                                <Button x:Name="BtnOfflineLogin" Grid.Column="1"
                                                        Style="{StaticResource BaseButton}" Content="Создать и войти"
                                                        Margin="8,0,0,0" Click="BtnOfflineLogin_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtOfflineHint" Text="Введите никнейм (3-16 символов)."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="СМЕНА СКИНА" Style="{StaticResource Caption}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtSkinPath" Grid.Column="0" IsReadOnly="True"/>
                                                <Button x:Name="BtnBrowseSkin" Grid.Column="1"
                                                        Style="{StaticResource BaseButton}" Content="Обзор…"
                                                        Margin="8,0,0,0" Click="BtnBrowseSkin_Click"/>
                                            </Grid>
                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <TextBlock Text="Модель:" VerticalAlignment="Center"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <RadioButton x:Name="RbClassic" Content="Classic" IsChecked="True"
                                                             GroupName="SkinModel" Margin="12,0,0,0"
                                                             VerticalAlignment="Center" Foreground="{DynamicResource Fg}"
                                                             FontSize="12" Cursor="Hand"/>
                                                <RadioButton x:Name="RbSlim" Content="Slim" GroupName="SkinModel"
                                                             Margin="16,0,0,0" VerticalAlignment="Center"
                                                             Foreground="{DynamicResource Fg}" FontSize="12" Cursor="Hand"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                                <Button x:Name="BtnUploadSkin" Style="{StaticResource AccentButton}"
                                                        Content="Сменить скин" Click="BtnUploadSkin_Click"
                                                        IsEnabled="False" MinWidth="150"/>
                                                <Button x:Name="BtnResetSkin" Style="{StaticResource BaseButton}"
                                                        Content="Сбросить" Margin="10,0,0,0"
                                                        Click="BtnResetSkin_Click" IsEnabled="False"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtSkinStatus" Text="" Margin="0,10,0,0"
                                                       FontSize="11.5" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource FgMuted}"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ 4. НАСТРОЙКИ ============ -->
                    <Grid x:Name="PageSettings" Grid.Row="0" Margin="24,14,18,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Margin="0,0,6,0">
                            <TextBlock Text="Настройки" Style="{StaticResource H1}"/>
                            <TextBlock x:Name="TxtSettingsHint" Text="Изменения применяются и сохраняются сразу"
                                       Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource IconButton}" Content="Сбросить раздел"
                                    Margin="0,0,16,0" Click="BtnResetSection_Click"
                                    VerticalAlignment="Center"
                                    ToolTip="Вернуть настройки этого раздела к значениям по умолчанию"/>
                            <RadioButton x:Name="SecGame" Style="{StaticResource SegmentToggle}" Content="Игра"
                                         IsChecked="True" Checked="SettingsSection_Checked" Tag="game"/>
                            <RadioButton x:Name="SecJava" Style="{StaticResource SegmentToggle}" Content="Java и память"
                                         Checked="SettingsSection_Checked" Tag="java"/>
                            <RadioButton x:Name="SecView" Style="{StaticResource SegmentToggle}" Content="Внешний вид"
                                         Checked="SettingsSection_Checked" Tag="view"/>
                            <RadioButton x:Name="SecStorage" Style="{StaticResource SegmentToggle}" Content="Хранилище"
                                         Checked="SettingsSection_Checked" Tag="storage"/>
                            <RadioButton x:Name="SecVersions" Style="{StaticResource SegmentToggle}" Content="Версии игры"
                                         Checked="SettingsSection_Checked" Tag="versions"/>
                            <RadioButton x:Name="SecMaint" Style="{StaticResource SegmentToggle}" Content="Обслуживание"
                                         Checked="SettingsSection_Checked" Tag="maint"/>
                        </StackPanel>

                        <ScrollViewer Grid.Row="2" Margin="0,14,0,0" VerticalScrollBarVisibility="Auto">
                            <Grid Margin="0,0,6,10">

                                <!-- ИГРА -->
                                <StackPanel x:Name="SecPanelGame">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ОКНО ИГРЫ" Style="{StaticResource Caption}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="Ширина" VerticalAlignment="Center" Width="60"
                                                           Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtWidth" Width="86" Text="1280"
                                                         LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                                <TextBlock Text="Высота" VerticalAlignment="Center" Margin="18,0,0,0"
                                                           Width="56" Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                                <TextBox x:Name="TxtHeight" Width="86" Text="720"
                                                         LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                                <CheckBox x:Name="ChkFullscreen" Content="Полный экран" Margin="20,0,0,0"
                                                          VerticalAlignment="Center" Checked="Setting_Changed"
                                                          Unchecked="Setting_Changed"/>
                                            </StackPanel>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="1280×720"
                                                        Margin="0,0,6,0" Click="Preset720_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="1600×900"
                                                        Margin="0,0,6,0" Click="Preset900_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="1920×1080"
                                                        Click="Preset1080_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ЗАПУСК" Style="{StaticResource Caption}"/>
                                            <CheckBox x:Name="ChkAllowMultiple" Checked="Setting_Changed"
                                                      Unchecked="Setting_Changed"
                                                      Content="Разрешить несколько копий игры одновременно"/>
                                            <TextBlock Text="Выключено — защита от случайного открытия десятков окон."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="27,4,0,0" TextWrapping="Wrap"/>

                                            <CheckBox x:Name="ChkMinimizeOnLaunch" Margin="0,12,0,0"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      Content="Сворачивать лаунчер при старте игры"/>
                                            <CheckBox x:Name="ChkConfirmStop" Margin="0,12,0,0"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      Content="Спрашивать подтверждение перед закрытием игры"/>
                                            <CheckBox x:Name="ChkCloseOnLaunch" Margin="0,12,0,0"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      Content="Полностью закрывать лаунчер после запуска"/>
                                            <CheckBox x:Name="ChkShowConsole" Margin="0,12,0,0"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"
                                                      Content="Показывать консоль Java (для отладки)"/>
                                            <CheckBox x:Name="ChkSnapshots" Margin="0,12,0,0"
                                                      Checked="ChkSnapshots_Changed" Unchecked="ChkSnapshots_Changed"
                                                      Content="Показывать снапшоты в списке версий"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ЯЗЫК ИГРЫ" Style="{StaticResource Caption}"/>
                                            <CheckBox x:Name="ChkAutoLanguage" Checked="Setting_Changed"
                                                      Unchecked="Setting_Changed"
                                                      Content="Ставить язык автоматически при первом запуске"/>
                                            <TextBlock Text="Minecraft по умолчанию стартует на английском. Лаунчер заранее пропишет выбранный язык в options.txt, чтобы не менять вручную."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="27,4,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="27,10,0,0">
                                                <RadioButton x:Name="RbLangRu" Style="{StaticResource SegmentToggle}"
                                                             Content="Русский" IsChecked="True"
                                                             Checked="GameLang_Checked" Tag="ru"/>
                                                <RadioButton x:Name="RbLangUk" Style="{StaticResource SegmentToggle}"
                                                             Content="Українська" Checked="GameLang_Checked" Tag="uk"/>
                                                <RadioButton x:Name="RbLangEn" Style="{StaticResource SegmentToggle}"
                                                             Content="English" Checked="GameLang_Checked" Tag="en"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="НОВЫЕ СБОРКИ" Style="{StaticResource Caption}"/>
                                            <CheckBox x:Name="ChkDefaultIsolated" Checked="Setting_Changed"
                                                      Unchecked="Setting_Changed"
                                                      Content="Создавать изолированными по умолчанию"/>
                                            <TextBlock Text="Изолированная сборка хранит свои библиотеки, ассеты и версии внутри своей папки. Надёжнее, но занимает больше места."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="27,4,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- JAVA И ПАМЯТЬ -->
                                <StackPanel x:Name="SecPanelJava" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ОПЕРАТИВНАЯ ПАМЯТЬ" Style="{StaticResource Caption}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SldMemory" Grid.Column="0" Minimum="1024" Maximum="16384"
                                                        TickFrequency="512" IsSnapToTickEnabled="True" Value="4096"
                                                        ValueChanged="SldMemory_ValueChanged" VerticalAlignment="Center"/>
                                                <TextBlock x:Name="TxtMemory" Grid.Column="1" Text="4096 МБ" Width="88"
                                                           TextAlignment="Right" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtMemoryHint" Text="" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="11" Margin="0,8,0,0" TextWrapping="Wrap"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="2 ГБ"
                                                        Margin="0,0,6,0" Click="Mem2_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="4 ГБ"
                                                        Margin="0,0,6,0" Click="Mem4_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="8 ГБ"
                                                        Margin="0,0,6,0" Click="Mem8_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="Авто"
                                                        Click="MemAuto_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="УСТАНОВЛЕННЫЕ JAVA" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Искать заново"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnRescanJava_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtJavaList" Text="Поиск…"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                            <TextBlock Text="Свой путь к java.exe (пусто = автоподбор)"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,14,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtJavaPath" Grid.Column="0" LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Обзор" Margin="8,0,0,0" Click="BtnBrowseJava_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="Сброс" Margin="8,0,0,0" Click="BtnClearJava_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="АРГУМЕНТЫ JVM" Style="{StaticResource Caption}"/>
                                            <TextBox x:Name="TxtJvmArgs" LostFocus="Setting_Changed" TextChanged="SettingText_Changed"/>
                                            <TextBlock Text="Добавляются к стандартным. Пример: -XX:+UseZGC"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11"
                                                       Margin="0,6,0,0"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ВНЕШНИЙ ВИД -->
                                <StackPanel x:Name="SecPanelView" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="ЦВЕТОВАЯ СХЕМА" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Создать свою…"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnCustomTheme_Click"/>
                                            </Grid>
                                            <ItemsControl x:Name="ItemsThemes">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="112" CornerRadius="10" Margin="0,0,9,9"
                                                                Cursor="Hand" MouseLeftButtonUp="ThemeCard_Click"
                                                                Tag="{Binding Name}" BorderThickness="2"
                                                                BorderBrush="{Binding Border}"
                                                                Background="{Binding Preview}">
                                                            <StackPanel Margin="10">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <Border Width="16" Height="16" CornerRadius="4"
                                                                            Background="{Binding Swatch1}"/>
                                                                    <Border Width="16" Height="16" CornerRadius="4"
                                                                            Margin="4,0,0,0" Background="{Binding Swatch2}"/>
                                                                    <Border Width="16" Height="16" CornerRadius="4"
                                                                            Margin="4,0,0,0" Background="{Binding Swatch3}"/>
                                                                </StackPanel>
                                                                <TextBlock Text="{Binding Name}" FontSize="11.5"
                                                                           FontWeight="SemiBold" Margin="0,8,0,0"
                                                                           Foreground="{Binding TextColor}"/>
                                                            </StackPanel>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ФОН ЛАУНЧЕРА" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Своя картинка на фоне всего окна."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,0,0,10"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtWindowBg" Grid.Column="0" IsReadOnly="True"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Выбрать фото" Margin="8,0,0,0"
                                                        Click="BtnPickWindowBg_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="Убрать" Margin="8,0,0,0"
                                                        Click="BtnClearWindowBg_Click"/>
                                            </Grid>
                                            <TextBlock Text="Насыщенность фона" Foreground="{DynamicResource FgMuted}"
                                                       FontSize="11.5" Margin="0,14,0,6"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <Slider x:Name="SldBgOpacity" Grid.Column="0" Minimum="5" Maximum="100"
                                                        Value="35" TickFrequency="5" IsSnapToTickEnabled="True"
                                                        VerticalAlignment="Center"
                                                        ValueChanged="SldBgOpacity_ValueChanged"/>
                                                <TextBlock x:Name="TxtBgOpacity" Grid.Column="1" Text="35%" Width="52"
                                                           TextAlignment="Right" VerticalAlignment="Center"
                                                           FontWeight="SemiBold"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ЦВЕТ АКЦЕНТА" Style="{StaticResource Caption}"/>
                                            <ItemsControl x:Name="ItemsAccents">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Width="34" Height="34" CornerRadius="9" Margin="0,0,8,8"
                                                                Cursor="Hand" MouseLeftButtonUp="AccentSwatch_Click"
                                                                Tag="{Binding Hex}" ToolTip="{Binding Name}"
                                                                BorderThickness="2" BorderBrush="{Binding Border}"
                                                                Background="{Binding Brush}"/>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ФОН ГЛАВНОГО ЭКРАНА" Style="{StaticResource Caption}"/>
                                            <StackPanel x:Name="PanelBgStyles" Orientation="Horizontal"/>
                                            <Grid Margin="0,14,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtBannerPath" Grid.Column="0" IsReadOnly="True"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Своя картинка" Margin="8,0,0,0"
                                                        Click="BtnPickBanner_Click"/>
                                                <Button Grid.Column="2" Style="{StaticResource IconButton}"
                                                        Content="Убрать" Margin="8,0,0,0" Click="BtnClearBanner_Click"/>
                                            </Grid>
                                            <CheckBox x:Name="ChkAnimations" Content="Плавные анимации" Margin="0,14,0,0"
                                                      Checked="Setting_Changed" Unchecked="Setting_Changed"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ОБСЛУЖИВАНИЕ -->
                                <StackPanel x:Name="SecPanelMaint" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="ЧТО ЗАНИМАЕТ МЕСТО" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Пересчитать"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnScanMaint_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtMaintTotal" Text="Нажмите «Пересчитать»"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,0,0,12"/>

                                            <ItemsControl x:Name="ItemsMaint">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg}" CornerRadius="9"
                                                                Padding="11" Margin="0,0,0,7" BorderThickness="1"
                                                                BorderBrush="{Binding RowBorder}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <CheckBox Grid.Column="0" IsChecked="{Binding Checked, Mode=OneTime}"
                                                                          VerticalAlignment="Center" Tag="{Binding Key}"
                                                                          Checked="MaintItem_Changed"
                                                                          Unchecked="MaintItem_Changed"/>

                                                                <StackPanel Grid.Column="1" Margin="10,0,10,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Title}" FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{Binding TitleColor}"/>
                                                                    <TextBlock Text="{Binding Description}" FontSize="10.5"
                                                                               Foreground="{DynamicResource FgMuted}"
                                                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <TextBlock Grid.Column="2" Text="{Binding SizeText}"
                                                                           FontSize="12" FontWeight="SemiBold"
                                                                           VerticalAlignment="Center"
                                                                           Foreground="{DynamicResource Fg}"/>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>

                                            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                                <Button Style="{StaticResource IconButton}" Content="Выбрать безопасное"
                                                        Margin="0,0,8,0" Click="BtnMaintSafe_Click"/>
                                                <Button Style="{StaticResource DangerButton}" Content="Удалить выбранное"
                                                        Click="BtnMaintClean_Click"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ПОЛНЫЙ СБРОС И УДАЛЕНИЕ" Style="{StaticResource Caption}"/>
                                            <TextBlock Text="Эти действия необратимы. Игровые миры и моды будут потеряны."
                                                       Foreground="{DynamicResource Danger}" FontSize="11.5"
                                                       Margin="0,0,0,12" TextWrapping="Wrap"/>

                                            <Button Style="{StaticResource IconButton}"
                                                    Content="Переустановить начисто (сохранить сборки)"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                    Click="BtnReinstallSoft_Click"/>
                                            <Button Style="{StaticResource DangerButton}"
                                                    Content="Полная переустановка (удалить всё)"
                                                    HorizontalContentAlignment="Left" Margin="0,0,0,8"
                                                    Click="BtnReinstallFull_Click"/>
                                            <Button Style="{StaticResource DangerButton}"
                                                    Content="Удалить лаунчер с компьютера"
                                                    HorizontalContentAlignment="Left"
                                                    Click="BtnUninstall_Click"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ВЕРСИИ ИГРЫ -->
                                <StackPanel x:Name="SecPanelVersions" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="УСТАНОВЛЕННЫЕ ВЕРСИИ" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Обновить список"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnScanVersions_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtVersionsSummary" Text="Нажмите «Обновить список»"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       Margin="0,0,0,10"/>

                                            <ItemsControl x:Name="ItemsVersions">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Background="{DynamicResource Bg}" CornerRadius="9"
                                                                Padding="12" Margin="0,0,0,8" BorderThickness="1"
                                                                BorderBrush="{DynamicResource BorderBrushDark}">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>

                                                                <Border Grid.Column="0" CornerRadius="5" Padding="7,3"
                                                                        VerticalAlignment="Center"
                                                                        Background="{Binding KindBg}">
                                                                    <TextBlock Text="{Binding Kind}" FontSize="9.5"
                                                                               FontWeight="Bold"
                                                                               Foreground="{Binding KindFg}"/>
                                                                </Border>

                                                                <StackPanel Grid.Column="1" Margin="11,0,10,0"
                                                                            VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding Id}" FontSize="12.5"
                                                                               FontWeight="SemiBold"
                                                                               Foreground="{DynamicResource Fg}"/>
                                                                    <TextBlock Text="{Binding Info}" FontSize="10.5"
                                                                               Foreground="{DynamicResource FgMuted}"
                                                                               Margin="0,3,0,0" TextWrapping="Wrap"/>
                                                                </StackPanel>

                                                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                    <Button Content="Папка"
                                                                            Style="{StaticResource IconButton}"
                                                                            Click="VersionOpen_Click"
                                                                            Tag="{Binding Dir}"/>
                                                                    <Button Content="Удалить"
                                                                            Style="{StaticResource DangerButton}"
                                                                            Margin="8,0,0,0" Padding="10,7"
                                                                            Click="VersionDelete_Click"
                                                                            Tag="{Binding Id}"/>
                                                                </StackPanel>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>

                                <!-- ХРАНИЛИЩЕ -->
                                <StackPanel x:Name="SecPanelStorage" Visibility="Collapsed">
                                    <Border Style="{StaticResource Card}">
                                        <StackPanel>
                                            <TextBlock Text="ПАПКА ЛАУНЧЕРА" Style="{StaticResource Caption}"/>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtGameDir" Grid.Column="0" IsReadOnly="True"/>
                                                <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                                        Content="Открыть" Margin="8,0,0,0" Click="BtnOpenDir_Click"/>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ПОРТАТИВНЫЙ РЕЖИМ" Style="{StaticResource Caption}"/>
                                            <TextBlock x:Name="TxtPortableState" Text=""
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       TextWrapping="Wrap" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button x:Name="BtnPortableToggle" Style="{StaticResource IconButton}"
                                                        Content="Включить портативный режим"
                                                        Click="BtnPortableToggle_Click"/>
                                            </StackPanel>
                                            <TextBlock Text="Данные будут храниться рядом с лаунчером — можно носить на флешке вместе со сборками."
                                                       Foreground="{DynamicResource FgMuted}" FontSize="10.5"
                                                       Margin="0,8,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <Grid>
                                                <TextBlock Text="ЗАНЯТОЕ МЕСТО" Style="{StaticResource Caption}"/>
                                                <Button Style="{StaticResource IconButton}" Content="Пересчитать"
                                                        HorizontalAlignment="Right" VerticalAlignment="Top"
                                                        Margin="0,-6,0,0" Click="BtnCalcSize_Click"/>
                                            </Grid>
                                            <TextBlock x:Name="TxtStorageInfo" Text="Нажмите «Пересчитать»"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       TextWrapping="Wrap" LineHeight="19"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource Card}" Margin="0,12,0,0">
                                        <StackPanel>
                                            <TextBlock Text="ОБСЛУЖИВАНИЕ" Style="{StaticResource Caption}"/>
                                            <StackPanel Orientation="Horizontal">
                                                <Button Style="{StaticResource IconButton}" Content="Очистить кэш"
                                                        Margin="0,0,8,0" Click="BtnClearCache_Click"/>
                                                <Button Style="{StaticResource IconButton}" Content="Проверить CurseForge"
                                                        Margin="0,0,8,0" Click="BtnCheckCurse_Click"/>
                                                <Button Style="{StaticResource DangerButton}" Content="Сбросить настройки"
                                                        Click="BtnResetSettings_Click"/>
                                            </StackPanel>
                                            <TextBlock x:Name="TxtMaintenance" Text="" Margin="0,10,0,0"
                                                       Foreground="{DynamicResource FgMuted}" FontSize="11.5"
                                                       TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>
                    </Grid>

                    <!-- ============ 5. КОНСОЛЬ ============ -->
                    <Grid x:Name="PageConsole" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Консоль" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="TxtLogInfo" Text="Журнал лаунчера и вывод игры"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <RadioButton x:Name="LogAll" Style="{StaticResource SegmentToggle}"
                                             Content="Всё" IsChecked="True" Checked="LogFilter_Checked" Tag="all"/>
                                <RadioButton x:Name="LogWarn" Style="{StaticResource SegmentToggle}"
                                             Content="Предупреждения" Checked="LogFilter_Checked" Tag="warn"/>
                                <RadioButton x:Name="LogErr" Style="{StaticResource SegmentToggle}"
                                             Content="Ошибки" Checked="LogFilter_Checked" Tag="error"/>
                                <Button x:Name="BtnOpenLogFile" Style="{StaticResource IconButton}"
                                        Content="Файл лога" Margin="10,0,8,0" Click="BtnOpenLogFile_Click"/>
                                <Button x:Name="BtnClearLog" Style="{StaticResource IconButton}"
                                        Content="Очистить" Click="BtnClearLog_Click"/>
                            </StackPanel>
                        </Grid>

                        <Border Grid.Row="1" Margin="0,14,0,0" Background="{DynamicResource ConsoleBg}"
                                BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1" CornerRadius="10">
                            <ScrollViewer x:Name="ScrollLog" VerticalScrollBarVisibility="Auto" Margin="4">
                                <TextBox x:Name="TxtLog" Background="Transparent" BorderThickness="0"
                                         Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas" FontSize="11.5"
                                         IsReadOnly="True" TextWrapping="NoWrap" VerticalContentAlignment="Top"
                                         VerticalScrollBarVisibility="Disabled" HorizontalScrollBarVisibility="Auto"/>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <!-- ============ 6. МОДЫ ============ -->
                    <Grid x:Name="PageMods" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Моды" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="TxtModsSubtitle" Text="Modrinth и CurseForge"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButton}" Content="Импорт .jar"
                                        Margin="0,0,8,0" Click="BtnImportMod_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="Из ссылки Modrinth"
                                        Click="BtnImportUrl_Click"/>
                            </StackPanel>
                        </Grid>

                        <!-- Панель поиска -->
                        <Grid x:Name="ModSearchBar" Grid.Row="1" Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <TextBox x:Name="TxtModSearch" Grid.Column="0" Height="38"
                                     KeyDown="TxtModSearch_KeyDown"
                                     ToolTip="Название мода. Пустой запрос покажет самые популярные."/>

                            <ComboBox x:Name="CbModType" Grid.Column="1" Width="146" Height="38" Margin="8,0,0,0"
                                      SelectionChanged="ModFilter_Changed">
                                <ComboBoxItem Content="Моды" IsSelected="True" Tag="0"/>
                                <ComboBoxItem Content="Ресурспаки" Tag="1"/>
                                <ComboBoxItem Content="Шейдеры" Tag="2"/>
                            </ComboBox>

                            <ComboBox x:Name="CbModSource" Grid.Column="2" Width="140" Height="38" Margin="8,0,0,0"
                                      SelectionChanged="ModFilter_Changed">
                                <ComboBoxItem Content="Все источники" IsSelected="True" Tag="all"/>
                                <ComboBoxItem Content="Modrinth" Tag="modrinth"/>
                                <ComboBoxItem Content="CurseForge" Tag="curseforge"/>
                            </ComboBox>

                            <Button x:Name="BtnModSearch" Grid.Column="3" Style="{StaticResource AccentButton}"
                                    Content="Найти" Height="38" MinWidth="104" Margin="8,0,0,0"
                                    Click="BtnModSearchNew_Click"/>
                        </Grid>

                        <!-- Каталог -->
                        <Grid x:Name="PanelBrowse" Grid.Row="2" Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <ScrollViewer x:Name="ModScroll" Grid.Row="0" VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,10">
                                    <TextBlock x:Name="TxtModStatus" Text="Введите запрос и нажмите «Найти»."
                                               Foreground="{DynamicResource FgMuted}" FontSize="12"
                                               TextWrapping="Wrap" Margin="2,0,0,10"/>

                                    <ItemsControl x:Name="ItemsMods">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="{DynamicResource Panel}" CornerRadius="11" Padding="14"
                                                        Margin="0,0,0,10" BorderThickness="1"
                                                        BorderBrush="{DynamicResource BorderBrushDark}">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto"/>
                                                            <ColumnDefinition Width="*"/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <Border Grid.Column="0" Width="54" Height="54" CornerRadius="9"
                                                                Background="#161A21" ClipToBounds="True">
                                                            <Grid>
                                                                <Image Source="{Binding Icon}" Stretch="UniformToFill"/>
                                                                <TextBlock Text="{Binding Initial}" FontSize="21"
                                                                           FontWeight="Bold" Foreground="#3A4150"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Visibility="{Binding PlaceholderVisibility}"/>
                                                            </Grid>
                                                        </Border>

                                                        <StackPanel Grid.Column="1" Margin="13,0,12,0"
                                                                    VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding Title}" FontWeight="Bold"
                                                                           FontSize="14"/>
                                                                <Border Style="{StaticResource Chip}" Margin="9,0,0,0"
                                                                        Background="{Binding SourceBg}">
                                                                    <TextBlock Text="{Binding Source}" FontSize="10"
                                                                               Foreground="{Binding SourceFg}"
                                                                               VerticalAlignment="Center"/>
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding Summary}" FontSize="11.5"
                                                                       Foreground="{DynamicResource FgMuted}"
                                                                       Margin="0,5,0,0" TextWrapping="Wrap"
                                                                       MaxHeight="34" TextTrimming="CharacterEllipsis"/>
                                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                                <TextBlock Text="{Binding DownloadsText}" FontSize="11"
                                                                           Foreground="#6B7280"/>
                                                                <TextBlock Text="{Binding AuthorText}" FontSize="11"
                                                                           Foreground="#6B7280" Margin="12,0,0,0"/>
                                                            </StackPanel>
                                                        </StackPanel>

                                                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                            <Button Content="Установить"
                                                                    Style="{StaticResource AccentButton}"
                                                                    MinWidth="122" Click="ModInstall_Click"
                                                                    Tag="{Binding Index}"/>
                                                            <Grid Margin="0,6,0,0">
                                                                <Grid.ColumnDefinitions>
                                                                    <ColumnDefinition Width="*"/>
                                                                    <ColumnDefinition Width="Auto"/>
                                                                </Grid.ColumnDefinitions>
                                                                <Button Grid.Column="0" Content="Открыть"
                                                                        Style="{StaticResource IconButton}"
                                                                        Click="ModPageInApp_Click"
                                                                        Tag="{Binding Index}"
                                                                        ToolTip="Показать страницу мода в лаунчере"/>
                                                                <Button Grid.Column="1" Content="&#xE8A7;"
                                                                        FontFamily="Segoe MDL2 Assets" FontSize="11"
                                                                        Style="{StaticResource IconButton}"
                                                                        Margin="6,0,0,0" Padding="9,7"
                                                                        Click="ModPage_Click"
                                                                        Tag="{Binding PageUrl}"
                                                                        ToolTip="Открыть в браузере"/>
                                                            </Grid>
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <Border x:Name="ModPager" Grid.Row="1" Visibility="Collapsed"
                                    Background="{DynamicResource Panel}" CornerRadius="10" Padding="10"
                                    Margin="0,4,6,6" BorderThickness="1"
                                    BorderBrush="{DynamicResource BorderBrushDark}">
                                <Grid>
                                    <Button x:Name="BtnPrevPage" Style="{StaticResource IconButton}"
                                            Content="&#x2190;  Назад" HorizontalAlignment="Left"
                                            MinWidth="112" Click="BtnPrevPage_Click"/>
                                    <TextBlock x:Name="TxtPageInfo" Text="" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{DynamicResource Fg}"/>
                                    <Button x:Name="BtnNextPage" Style="{StaticResource IconButton}"
                                            Content="Вперёд  &#x2192;" HorizontalAlignment="Right"
                                            MinWidth="112" Click="BtnNextPage_Click"/>
                                </Grid>
                            </Border>
                        </Grid>

                    </Grid>

                    <!-- ============ 7. КОНТЕНТ СБОРКИ ============ -->
                    <Grid x:Name="PageContent" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed"
                          AllowDrop="True" Drop="Content_Drop" DragOver="Content_DragOver">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Контент сборки" Style="{StaticResource H1}"/>
                                <TextBlock x:Name="TxtContentSubtitle" Text="Моды, ресурспаки, шейдеры и миры"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                                <Button Style="{StaticResource IconButton}" Content="Импорт файлов"
                                        Margin="0,0,8,0" Click="BtnImportMod_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="Открыть папку"
                                        Margin="0,0,8,0" Click="BtnOpenContentFolder_Click"/>
                                <Button Style="{StaticResource IconButton}" Content="Обновить"
                                        Click="BtnRefreshContent_Click"/>
                            </StackPanel>
                        </Grid>

                        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton x:Name="CtMods" Style="{StaticResource SegmentToggle}" Content="Моды"
                                         IsChecked="True" Checked="ContentKind_Checked" Tag="mods"/>
                            <RadioButton x:Name="CtRp" Style="{StaticResource SegmentToggle}" Content="Ресурспаки"
                                         Checked="ContentKind_Checked" Tag="rp"/>
                            <RadioButton x:Name="CtShaders" Style="{StaticResource SegmentToggle}" Content="Шейдеры"
                                         Checked="ContentKind_Checked" Tag="shaders"/>
                            <RadioButton x:Name="CtWorlds" Style="{StaticResource SegmentToggle}" Content="Миры"
                                         Checked="ContentKind_Checked" Tag="worlds"/>
                        </StackPanel>

                        <Border Grid.Row="2" Margin="0,12,0,0" Background="Transparent">
                            <Grid>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,6,10">
                                        <Grid Margin="2,0,0,10">
                                            <TextBlock x:Name="TxtContentStatus" Text=""
                                                       Foreground="{DynamicResource FgMuted}" FontSize="12"/>
                                        </Grid>

                                        <ItemsControl x:Name="ItemsContent">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="{DynamicResource Panel}" CornerRadius="10"
                                                            Padding="13" Margin="0,0,0,8" BorderThickness="1"
                                                            BorderBrush="{DynamicResource BorderBrushDark}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                            </Grid.ColumnDefinitions>

                                                            <Ellipse Grid.Column="0" Width="9" Height="9"
                                                                     VerticalAlignment="Center" Fill="{Binding Dot}"/>

                                                            <StackPanel Grid.Column="1" Margin="12,0,10,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                           FontWeight="SemiBold"
                                                                           Foreground="{DynamicResource Fg}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                                <TextBlock Text="{Binding Info}" FontSize="10.5"
                                                                           Foreground="{DynamicResource FgMuted}"
                                                                           Margin="0,3,0,0"/>
                                                            </StackPanel>

                                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                                <Button Content="{Binding ToggleText}"
                                                                        Style="{StaticResource IconButton}"
                                                                        MinWidth="92" Click="ContentToggle_Click"
                                                                        Tag="{Binding Path}"
                                                                        Visibility="{Binding ToggleVisibility}"/>
                                                                <Button Content="Показать"
                                                                        Style="{StaticResource IconButton}"
                                                                        Margin="8,0,0,0" Click="ContentReveal_Click"
                                                                        Tag="{Binding Path}"/>
                                                                <Button Content="Удалить"
                                                                        Style="{StaticResource DangerButton}"
                                                                        Margin="8,0,0,0" Padding="10,7"
                                                                        Click="ContentDelete_Click"
                                                                        Tag="{Binding Path}"/>
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </ScrollViewer>

                                <!-- Подсказка при перетаскивании -->
                                <Border x:Name="DropHint" Visibility="Collapsed" CornerRadius="12"
                                        Background="#CC101418" BorderThickness="2"
                                        BorderBrush="{DynamicResource Accent}">
                                    <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                                        <TextBlock Text="&#xE896;" FontFamily="Segoe MDL2 Assets" FontSize="34"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource Accent}"/>
                                        <TextBlock Text="Отпустите файлы, чтобы добавить в сборку"
                                                   FontSize="14" FontWeight="SemiBold" Margin="0,12,0,0"
                                                   Foreground="{DynamicResource Fg}"/>
                                        <TextBlock x:Name="TxtDropTarget" Text="" FontSize="11.5" Margin="0,5,0,0"
                                                   HorizontalAlignment="Center"
                                                   Foreground="{DynamicResource FgMuted}"/>
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>

                    <!-- ============ 8. БОТ ============ -->
                    <Grid x:Name="PageBot" Grid.Row="0" Margin="24,14,24,0" Visibility="Collapsed">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                        </Grid.RowDefinitions>

                        <Grid Grid.Row="0">
                            <StackPanel>
                                <TextBlock Text="Бот-помощник" Style="{StaticResource H1}"/>
                                <TextBlock Text="Второй игрок для съёмки роликов — заходит в ваш мир по локальной сети"
                                           Foreground="{DynamicResource FgMuted}" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                            <Border Style="{StaticResource Chip}" HorizontalAlignment="Right"
                                    VerticalAlignment="Top" Background="{Binding}" x:Name="BotStatusChip">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="BotDot" Width="8" Height="8" VerticalAlignment="Center"
                                             Fill="#6B7280"/>
                                    <TextBlock x:Name="TxtBotStatus" Text="остановлен" FontSize="11"
                                               Margin="7,0,0,0" VerticalAlignment="Center"
                                               Foreground="{DynamicResource FgMuted}"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,14,0,0">
                            <StackPanel>
                                <Grid>
                                    <TextBlock Text="ПОДКЛЮЧЕНИЕ" Style="{StaticResource Caption}"/>
                                    <Button x:Name="BtnFindLan" Style="{StaticResource AccentButton}"
                                            Content="Найти мой мир" HorizontalAlignment="Right"
                                            VerticalAlignment="Top" Margin="0,-8,0,0"
                                            Click="BtnFindLan_Click"/>
                                </Grid>
                                <TextBlock Text="Откройте мир: Esc → «Открыть для сети» → «Открыть мир». Затем нажмите «Найти мой мир» — порт подставится сам."
                                           Foreground="{DynamicResource FgMuted}" FontSize="11"
                                           Margin="0,0,0,10" TextWrapping="Wrap"/>

                                <Border x:Name="LanResults" Visibility="Collapsed" CornerRadius="8"
                                        Background="{DynamicResource Bg}" Padding="10" Margin="0,0,0,12"
                                        BorderBrush="{DynamicResource Accent}" BorderThickness="1">
                                    <StackPanel>
                                        <TextBlock x:Name="TxtLanStatus" Text="" FontSize="11.5"
                                                   Foreground="{DynamicResource Fg}" TextWrapping="Wrap"/>
                                        <ItemsControl x:Name="ItemsLan" Margin="0,8,0,0">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource IconButton}"
                                                            Margin="0,0,0,5" Click="LanWorld_Click"
                                                            Tag="{Binding Key}"
                                                            HorizontalContentAlignment="Left">
                                                        <StackPanel>
                                                            <TextBlock Text="{Binding Motd}" FontSize="12"
                                                                       FontWeight="SemiBold"/>
                                                            <TextBlock Text="{Binding Addr}" FontSize="10.5"
                                                                       Foreground="{DynamicResource FgMuted}"
                                                                       Margin="0,2,0,0"/>
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Адрес" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtBotHost" Text="localhost" Height="36"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock Text="Порт" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtBotPort" Text="25565" Width="92" Height="36"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="2" Margin="10,0,0,0">
                                        <TextBlock Text="Ник бота" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                        <TextBox x:Name="TxtBotName" Text="MaysBot" Width="140" Height="36"/>
                                    </StackPanel>

                                    <StackPanel Grid.Column="3" Margin="10,0,0,0">
                                        <TextBlock Text="Версия" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                        <ComboBox x:Name="CbBotVersion" Width="118" Height="36"
                                                  IsEditable="True"
                                                  ToolTip="Версия мира. Пусто — определить автоматически"/>
                                    </StackPanel>
                                </Grid>

                                    <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                                    <Button x:Name="BtnBotStart" Style="{StaticResource AccentButton}"
                                            Content="Добавить бота" MinWidth="150" Click="BtnBotStart_Click"/>
                                    <Button x:Name="BtnBotStopAll" Style="{StaticResource StopButton}"
                                            Content="Остановить всех" MinWidth="150" Margin="10,0,0,0"
                                            Click="BtnBotStopAll_Click" IsEnabled="False"/>
                                    <Button x:Name="BtnBotSetup" Style="{StaticResource IconButton}"
                                            Content="Проверить окружение" Margin="10,0,0,0"
                                            Click="BtnBotSetup_Click"/>
                                </StackPanel>

                                <ItemsControl x:Name="ItemsBots" Margin="0,12,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="{DynamicResource Bg}" CornerRadius="9"
                                                    Padding="11" Margin="0,0,0,7" BorderThickness="1"
                                                    BorderBrush="{Binding Border}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                    </Grid.ColumnDefinitions>

                                                    <Ellipse Grid.Column="0" Width="9" Height="9"
                                                             VerticalAlignment="Center" Fill="{Binding Dot}"/>

                                                    <StackPanel Grid.Column="1" Margin="11,0,10,0"
                                                                VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Name}" FontSize="12.5"
                                                                   FontWeight="SemiBold"
                                                                   Foreground="{DynamicResource Fg}"/>
                                                        <TextBlock Text="{Binding Info}" FontSize="10.5"
                                                                   Foreground="{DynamicResource FgMuted}"
                                                                   Margin="0,3,0,0"/>
                                                    </StackPanel>

                                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                        <Button Content="Выбрать" Style="{StaticResource IconButton}"
                                                                MinWidth="84" Click="BotSelect_Click"
                                                                Tag="{Binding Id}"
                                                                ToolTip="Команды будут уходить этому боту"/>
                                                        <Button Content="Стоп" Style="{StaticResource DangerButton}"
                                                                Margin="8,0,0,0" Padding="10,7"
                                                                Click="BotStopOne_Click" Tag="{Binding Id}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock x:Name="TxtBotEnv" Text="" Foreground="{DynamicResource FgMuted}"
                                           FontSize="11" Margin="0,10,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>

                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="230"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Команды -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock x:Name="TxtBotTarget" Text="УПРАВЛЕНИЕ"
                                               Style="{StaticResource Caption}"/>
                                    <CheckBox x:Name="ChkBotAll" Content="Команды всем ботам"
                                              Margin="0,0,0,10" FontSize="11"/>

                                    <Button Style="{StaticResource IconButton}" Content="Идти за мной"
                                            Margin="0,0,0,6" Click="BotFollow_Click"
                                            HorizontalContentAlignment="Left"/>
                                    <Button Style="{StaticResource IconButton}" Content="Стоять"
                                            Margin="0,0,0,6" Click="BotStop_Click"
                                            HorizontalContentAlignment="Left"/>
                                    <Button Style="{StaticResource IconButton}" Content="Смотреть на меня"
                                            Margin="0,0,0,6" Click="BotLook_Click"
                                            HorizontalContentAlignment="Left"/>
                                    <Button Style="{StaticResource IconButton}" Content="Прыгнуть"
                                            Margin="0,0,0,6" Click="BotJump_Click"
                                            HorizontalContentAlignment="Left"/>

                                    <Border Style="{StaticResource Divider}"/>

                                    <Button Style="{StaticResource IconButton}" Content="Координаты"
                                            Margin="0,0,0,6" Click="BotPos_Click"
                                            HorizontalContentAlignment="Left"/>
                                    <Button Style="{StaticResource IconButton}" Content="Игроки на сервере"
                                            Margin="0,0,0,6" Click="BotPlayers_Click"
                                            HorizontalContentAlignment="Left"/>
                                    <Button Style="{StaticResource IconButton}" Content="Инвентарь"
                                            Click="BotInv_Click" HorizontalContentAlignment="Left"/>

                                    <Border Style="{StaticResource Divider}"/>

                                    <TextBlock Text="Ваш ник в игре" Style="{StaticResource Caption}"/>
                                    <TextBox x:Name="TxtBotOwner" Text=""
                                             ToolTip="За кем следовать / на кого смотреть"/>
                                </StackPanel>
                            </Border>

                            <!-- Консоль бота -->
                            <Grid Grid.Column="1" Margin="12,0,0,0">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <Border Grid.Row="0" Background="{DynamicResource ConsoleBg}" CornerRadius="10"
                                        BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="1">
                                    <ScrollViewer x:Name="BotScroll" VerticalScrollBarVisibility="Auto" Margin="4">
                                        <TextBox x:Name="TxtBotLog" Background="Transparent" BorderThickness="0"
                                                 Foreground="{DynamicResource ConsoleFg}" FontFamily="Consolas"
                                                 FontSize="11.5" IsReadOnly="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Disabled"/>
                                    </ScrollViewer>
                                </Border>

                                <Grid Grid.Row="1" Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="TxtBotChat" Grid.Column="0" Height="36"
                                             KeyDown="TxtBotChat_KeyDown"
                                             ToolTip="Сообщение в чат от имени бота"/>
                                    <Button Grid.Column="1" Style="{StaticResource IconButton}"
                                            Content="Отправить" Margin="8,0,0,0" Click="BotSay_Click"/>
                                </Grid>
                            </Grid>
                        </Grid>
                    </Grid>

                    <!-- ============ НИЖНЯЯ ПАНЕЛЬ ============ -->
                    <Border Grid.Row="1" Background="{DynamicResource Bg}" CornerRadius="0,0,13,0"
                            BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0"
                            Padding="24,13">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" x:Name="ProgressArea" Margin="0,0,0,11" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock x:Name="TxtProgressStage" Text="" FontSize="11.5"
                                               Foreground="{DynamicResource Fg}" HorizontalAlignment="Left"/>
                                    <TextBlock x:Name="TxtProgressPercent" Text="0%" FontSize="11.5" FontWeight="Bold"
                                               Foreground="{DynamicResource Accent}" HorizontalAlignment="Right"/>
                                </Grid>
                                <ProgressBar x:Name="PbProgress" Grid.Row="1" Minimum="0" Maximum="100" Value="0"/>
                            </Grid>

                            <Grid Grid.Row="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                    <TextBlock Text="СБОРКА" Style="{StaticResource Caption}" Margin="0,0,0,5"/>
                                    <ComboBox x:Name="CbInstances" Width="290" HorizontalAlignment="Left"
                                              SelectionChanged="CbInstances_SelectionChanged"
                                              ToolTip="Какая сборка запустится по кнопке «ИГРАТЬ»"/>
                                </StackPanel>

                                <Button x:Name="BtnCancel" Grid.Column="1" Style="{StaticResource BaseButton}"
                                        Content="Отмена" Height="46" MinWidth="96" Margin="0,14,10,0"
                                        VerticalAlignment="Bottom" Click="BtnCancel_Click" Visibility="Collapsed"/>

                                <Button x:Name="BtnStopGame" Grid.Column="2" Style="{StaticResource StopButton}"
                                        Content="ОСТАНОВИТЬ" Height="46" MinWidth="150" Margin="0,14,10,0"
                                        VerticalAlignment="Bottom" Click="BtnStopGame_Click" Visibility="Collapsed"/>

                                <Button x:Name="BtnPlay" Grid.Column="3" Style="{StaticResource AccentButton}"
                                        Content="ИГРАТЬ" FontSize="16" Height="46" MinWidth="188"
                                        Margin="0,14,0,0" VerticalAlignment="Bottom" Click="BtnPlay_Click"/>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
            </Grid>
    </Border>
</Window>
