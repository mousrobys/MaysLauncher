<Window x:Class="MCLauncher.Views.ModBrowserDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Страница мода"
        
        Height="720" Width="1060"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        FontFamily="Segoe UI, Tahoma, Arial">

    <Border Background="{DynamicResource CyberBg}" CornerRadius="14"
            BorderBrush="{DynamicResource NeonBorder}" BorderThickness="1.5">
        <Border.Effect>
            <DropShadowEffect BlurRadius="20" ShadowDepth="0" Opacity="0.5" Color="#FF2D95"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Height="52" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <Button x:Name="BtnBack" Style="{StaticResource IconButton}" Content="&#xE72B;"
                            FontFamily="Segoe MDL2 Assets" Width="34" Padding="0"
                            Click="BtnBack_Click" IsEnabled="False" ToolTip="Назад"/>
                    <Button x:Name="BtnForward" Style="{StaticResource IconButton}" Content="&#xE72A;"
                            FontFamily="Segoe MDL2 Assets" Width="34" Padding="0" Margin="6,0,0,0"
                            Click="BtnForward_Click" IsEnabled="False" ToolTip="Вперёд"/>
                    <Button x:Name="BtnReload" Style="{StaticResource IconButton}" Content="&#xE72C;"
                            FontFamily="Segoe MDL2 Assets" Width="34" Padding="0" Margin="6,0,0,0"
                            Click="BtnReload_Click" ToolTip="Обновить"/>
                </StackPanel>

                <Border Grid.Column="1" Width="26" Height="26" CornerRadius="6" Margin="12,0,0,0"
                        Background="{DynamicResource Panel}" ClipToBounds="True"
                        VerticalAlignment="Center">
                    <Image x:Name="ImgIcon" Stretch="UniformToFill"/>
                </Border>

                <StackPanel Grid.Column="2" Margin="10,0,10,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtTitle" Text="Загрузка…" FontWeight="SemiBold" FontSize="13"
                               Foreground="{DynamicResource Fg}" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="TxtUrl" Text="" FontSize="10.5"
                               Foreground="{DynamicResource FgMuted}" TextTrimming="CharacterEllipsis"/>
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal">
                    <Button x:Name="BtnExternal" Style="{StaticResource IconButton}"
                            Content="В браузере" Margin="0,0,8,0" Click="BtnExternal_Click"
                            VerticalAlignment="Center"/>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            Click="BtnClose_Click"/>
                </StackPanel>
            </Grid>

            <!-- Содержимое -->
            <Grid Grid.Row="1" Margin="1,0">
                <wv2:WebView2 x:Name="Browser" Visibility="Collapsed"/>

                <StackPanel x:Name="PanelFallback" VerticalAlignment="Center"
                            HorizontalAlignment="Center" MaxWidth="480">
                    <TextBlock x:Name="TxtFallbackIcon" Text="&#xE774;" FontFamily="Segoe MDL2 Assets"
                               FontSize="42" HorizontalAlignment="Center"
                               Foreground="{DynamicResource FgMuted}"/>
                    <TextBlock x:Name="TxtFallback" Text="Открываю страницу…"
                               FontSize="14" Margin="0,16,0,0" TextAlignment="Center"
                               TextWrapping="Wrap" Foreground="{DynamicResource Fg}"/>
                    <TextBlock x:Name="TxtFallbackHint" Text="" FontSize="11.5" Margin="0,10,0,0"
                               TextAlignment="Center" TextWrapping="Wrap"
                               Foreground="{DynamicResource FgMuted}"/>
                    <Button x:Name="BtnFallbackOpen" Style="{StaticResource AccentButton}"
                            Content="Открыть в браузере" Margin="0,18,0,0" MinWidth="200"
                            HorizontalAlignment="Center" Click="BtnExternal_Click"/>
                </StackPanel>
            </Grid>

            <!-- Низ -->
            <Border Grid.Row="2" Background="{DynamicResource Bg}" CornerRadius="0,0,13,13"
                    BorderBrush="{DynamicResource BorderBrushDark}" BorderThickness="0,1,0,0"
                    Padding="14,10">
                <Grid>
                    <TextBlock x:Name="TxtStatus" Text="" FontSize="11.5"
                               Foreground="{DynamicResource FgMuted}" VerticalAlignment="Center"
                               TextTrimming="CharacterEllipsis" MaxWidth="520"
                               HorizontalAlignment="Left"/>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource BaseButton}" Content="Закрыть" MinWidth="100"
                                Click="BtnClose_Click"/>
                        <Button x:Name="BtnInstall" Style="{StaticResource AccentButton}"
                                Content="Установить этот мод" MinWidth="196" Margin="10,0,0,0"
                                Click="BtnInstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
