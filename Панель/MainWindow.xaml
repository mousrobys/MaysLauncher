<Window x:Class="LauncherPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher Panel" Height="650" Width="900"
        WindowStartupLocation="CenterScreen">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <TextBlock Text="&#xF28B;" FontFamily="Segoe MDL2 Assets" FontSize="20" VerticalAlignment="Center" Foreground="{StaticResource Green}"/>
                    <TextBlock Text="Launcher Panel" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl Grid.Row="1" x:Name="MainTabs" Background="{StaticResource Bg}" BorderThickness="0">
            <TabItem Header="&#xF28B; Новости">
                <Grid Background="{StaticResource Bg}" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Создать новость" Click="BtnCreateNews_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,6"/>

                    <DataGrid Grid.Row="1" x:Name="NewsGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="100"/>
                            <DataGridTextColumn Header="Заголовок" Binding="{Binding Title}" Width="*"/>
                            <DataGridTextColumn Header="Текст" Binding="{Binding Content}" Width="*"/>
                            <DataGridTemplateColumn Header="Важно" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Important, Converter={StaticResource BoolToMarkConverter}}" FontSize="16" HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="&#xE968; Серверы">
                <Grid Background="{StaticResource Bg}" Margin="16">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <Button Grid.Row="0" Content="+ Добавить сервер" Click="BtnAddServer_Click" HorizontalAlignment="Left" Margin="0,0,0,12" Padding="12,6"/>

                    <DataGrid Grid.Row="1" x:Name="ServersGrid" AutoGenerateColumns="False" IsReadOnly="True"
                              CanUserAddRows="False" SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="120"/>
                            <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="150"/>
                            <DataGridTextColumn Header="Версия" Binding="{Binding RequiredVersion}" Width="80"/>
                            <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <TabItem Header="&#xE713; Настройки">
                <ScrollViewer Background="{StaticResource Bg}" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16" MaxWidth="500" HorizontalAlignment="Left">
                        <TextBlock Text="GitHub" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,12"/>
                        <TextBlock Text="Owner" Foreground="{StaticResource Muted}" Margin="0,0,0,4"/>
                        <TextBox x:Name="TxtOwner" Text="mousrobys"/>
                        <TextBlock Text="Repository" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                        <TextBox x:Name="TxtRepo" Text="MaysLauncher"/>
                        <TextBlock Text="Personal Access Token" Foreground="{StaticResource Muted}" Margin="0,8,0,4"/>
                        <TextBox x:Name="TxtToken"/>
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button Content="Сохранить" Click="BtnSaveSettings_Click" Padding="12,6"/>
                            <Button Content="Проверить подключение" Click="BtnTestConnection_Click" Margin="8,0,0,0" Padding="12,6" Background="{StaticResource Card}" Foreground="{StaticResource Text}"/>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <Border Grid.Row="2" Background="{StaticResource Card}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Padding="12,8">
            <TextBlock x:Name="TxtStatus" Text="Готово" Foreground="{StaticResource Muted}" FontSize="12"/>
        </Border>
    </Grid>
</Window>
