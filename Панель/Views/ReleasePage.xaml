<UserControl x:Class="LauncherPanel.Views.ReleasePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🚀 Выпуск обновления" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="Тег версии:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtTag" Margin="0,4" Text="v1.1.0"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Название:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtName" Margin="0,4" Text="MaysLauncher v1.1.0"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Описание:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,4"/>
                <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtBody" AcceptsReturn="True" TextWrapping="Wrap" Height="120" Margin="0,4" Text="## Что нового&#x0a;- &#x0a;- &#x0a;-"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="EXE файл:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,4">
                    <Button Content="📂 Выбрать" Click="BrowseExe_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtExePath" IsReadOnly="True"/>
                </DockPanel>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2">
            <Button x:Name="BtnCreateRelease" Content="🚀 Создать релиз" Click="BtnCreateRelease_Click" HorizontalAlignment="Left" FontSize="14" Padding="24,12"/>
            <TextBlock x:Name="TxtReleaseStatus" Text="" Margin="0,16,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>

            <Separator Margin="0,24" Background="{StaticResource Border}"/>

            <TextBlock Text="📋 Последние релизы" FontSize="16" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,8"/>
            <TextBox x:Name="TxtReleases" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" 
                     Height="200" Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                     BorderBrush="{StaticResource Border}" Padding="8"/>
            <Button Content="🔄 Обновить список" Click="RefreshReleases_Click" HorizontalAlignment="Left" Margin="0,8,0,0"/>
        </StackPanel>
    </Grid>
</UserControl>
