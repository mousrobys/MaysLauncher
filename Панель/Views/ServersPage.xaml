<UserControl x:Class="LauncherPanel.Views.ServersPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="🖥️ Спонсорские серверы" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Button x:Name="BtnAddServer" Content="➕ Добавить сервер" Click="BtnAddServer_Click"/>
            <Button x:Name="BtnDeleteServer" Content="🗑️ Удалить" Click="BtnDeleteServer_Click" Margin="8,0,0,0" Style="{StaticResource DangerButton}"/>
            <Button x:Name="BtnPublish" Content="🚀 Опубликовать" Click="BtnPublish_Click" Margin="8,0,0,0" Background="#238636" Foreground="White"/>
        </StackPanel>

        <DataGrid Grid.Row="2" x:Name="ServersGrid" AutoGenerateColumns="False" 
                  Background="{StaticResource Bg}" Foreground="{StaticResource Text}"
                  BorderBrush="{StaticResource Border}" CanUserAddRows="False"
                  SelectionMode="Single" SelectionUnit="FullRow">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Название" Binding="{Binding Name}" Width="150"/>
                <DataGridTextColumn Header="Адрес" Binding="{Binding Address}" Width="150"/>
                <DataGridTextColumn Header="Версия" Binding="{Binding RequiredVersion}" Width="80"/>
                <DataGridTextColumn Header="Описание" Binding="{Binding Description}" Width="*"/>
            </DataGrid.Columns>
        </DataGrid>

        <Grid Grid.Row="3" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Row="0" Grid.Column="0" Text="Название:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtName" Margin="0,4"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Адрес:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtAddress" Margin="0,4"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Версия:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="2" Grid.Column="1" x:Name="TxtVersion" Margin="0,4"/>

            <TextBlock Grid.Row="3" Grid.Column="0" Text="Описание:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Top" Margin="0,4"/>
            <TextBox Grid.Row="3" Grid.Column="1" x:Name="TxtDescription" AcceptsReturn="True" TextWrapping="Wrap" Height="60" Margin="0,4"/>

            <TextBlock Grid.Row="4" Grid.Column="0" Text="Сайт:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,4"/>
            <TextBox Grid.Row="4" Grid.Column="1" x:Name="TxtSite" Margin="0,4"/>

            <CheckBox Grid.Row="5" Grid.Column="1" x:Name="ChkFeatured" Content="Спонсорский сервер" Foreground="{StaticResource Text}" Margin="0,8,0,0" IsChecked="True"/>
        </Grid>

        <TextBlock Grid.Row="4" x:Name="TxtPublishStatus" Text="" Margin="0,12,0,0" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
