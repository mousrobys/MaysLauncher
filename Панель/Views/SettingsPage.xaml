<UserControl x:Class="LauncherPanel.Views.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="⚙️ Настройки" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Text}" Margin="0,0,0,16"/>

        <StackPanel Grid.Row="1" Margin="0,0,0,24">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="GitHub владелец:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="0" Grid.Column="1" x:Name="TxtOwner" Margin="0,6" Text="mousrobys"/>

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Репозиторий:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,6"/>
                <TextBox Grid.Row="1" Grid.Column="1" x:Name="TxtRepo" Margin="0,6" Text="MaysLauncher"/>

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Personal Token:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,6"/>
                <PasswordBox Grid.Row="2" Grid.Column="1" x:Name="TxtToken" Margin="0,6"/>

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Путь к EXE:" Foreground="{StaticResource TextMuted}" VerticalAlignment="Center" Margin="0,6"/>
                <DockPanel Grid.Row="3" Grid.Column="1" Margin="0,6">
                    <Button Content="📂" Click="BrowseDefaultExe_Click" DockPanel.Dock="Right" Margin="8,0,0,0"/>
                    <TextBox x:Name="TxtDefaultExe" Text="билды exe/MaysLauncher.exe"/>
                </DockPanel>
            </Grid>

            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                <Button x:Name="BtnSave" Content="💾 Сохранить" Click="BtnSave_Click"/>
                <Button x:Name="BtnTest" Content="🔌 Проверить подключение" Click="BtnTest_Click" Margin="8,0,0,0" Background="{StaticResource Panel}" Foreground="{StaticResource Text}"/>
            </StackPanel>
        </StackPanel>

        <TextBlock Grid.Row="2" x:Name="TxtSettingsStatus" Text="" Foreground="{StaticResource TextMuted}" TextWrapping="Wrap"/>
    </Grid>
</UserControl>
